# Production Dockerfile for Celery Beat Cron Scheduler Process
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . /app

RUN useradd -m -u 1000 beatuser && chown -R beatuser:beatuser /app
USER beatuser

CMD ["celery", "-A", "app.jobs.celery_app.celery_app", "beat", "--loglevel=info"]
