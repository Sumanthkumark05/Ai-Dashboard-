# Centralized Environment Variables Template for NeuroDesk AI
APP_NAME="NeuroDesk AI"
APP_VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false
API_PREFIX="/api/v1"

# Security Secrets
SECRET_KEY="CHANGE_THIS_TO_SECURE_RANDOM_SECRET_KEY_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
DATABASE_URL="postgresql+asyncpg://neurodesk:password@localhost:5432/neurodesk_db"

# Redis & Task Queue
REDIS_URL="redis://localhost:6379/0"

# Storage Provider Configuration (local, s3)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./storage"
AWS_S3_BUCKET_NAME="neurodesk-uploads"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "https://app.neurodesk.ai"]

# Rate Limiting Settings
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=5
