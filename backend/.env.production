# NeuroDesk AI Production Environment Configuration

APP_NAME="NeuroDesk AI"
APP_VERSION="1.0.0"
API_PREFIX="/api/v1"
DEBUG=False
HOST="0.0.0.0"
PORT=8000
ENVIRONMENT="production"

SECRET_KEY="CHANGE_THIS_TO_A_64_CHAR_SECURE_RANDOM_KEY_IN_PROD"
JWT_SECRET_KEY="CHANGE_THIS_TO_A_64_CHAR_SECURE_RANDOM_KEY_IN_PROD"
FRONTEND_URL="https://app.neurodesk.ai"
CORS_ORIGINS=["https://app.neurodesk.ai"]

DB_HOST="postgres.production.internal"
DB_PORT=5432
DB_NAME="neurodesk_prod_db"
DB_USER="neurodesk_admin"
DB_PASSWORD="SECURE_PROD_DB_PASSWORD"

REDIS_HOST="redis.production.internal"
REDIS_PORT=6379
REDIS_PASSWORD="SECURE_REDIS_PASSWORD"

DEFAULT_MODEL="gpt-4o"
MODEL_TEMPERATURE=0.7
MAX_TOKENS=4096
UPLOAD_DIRECTORY="/var/app/uploads"
MAX_UPLOAD_SIZE_MB=50

ENABLE_CHAT=True
ENABLE_RAG=True
ENABLE_DOCUMENTS=True
ENABLE_TEAMS=True
ENABLE_BILLING=True
LOG_LEVEL="INFO"
