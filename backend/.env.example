# ==================== APPLICATION CONFIGURATION ====================
APP_NAME="NeuroDesk AI"
APP_VERSION="1.0.0"
APP_DESCRIPTION="Production Backend for NeuroDesk AI SaaS Platform"
API_PREFIX="/api/v1"
DEBUG=True
HOST="0.0.0.0"
PORT=8000
ENVIRONMENT="development"
TIMEZONE="UTC"

# ==================== SECURITY & AUTH CONFIGURATION ====================
SECRET_KEY="your_secure_random_application_secret_key_here"
JWT_SECRET_KEY="your_secure_random_jwt_signing_key_here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_MIN_LENGTH=8
SESSION_TIMEOUT_MINUTES=60
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["*"]

# ==================== DATABASE CONFIGURATION (POSTGRESQL) ====================
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="neurodesk_db"
DB_USER="postgres"
DB_PASSWORD="your_postgres_password"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/neurodesk_db"
# ASYNC_DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/neurodesk_db"

# ==================== REDIS CONFIGURATION ====================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
# REDIS_URL="redis://localhost:6379/0"

# ==================== CELERY CONFIGURATION ====================
# CELERY_BROKER_URL="redis://localhost:6379/0"
# CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# ==================== AI PROVIDERS CONFIGURATION ====================
OPENAI_API_KEY="sk-proj-your-openai-api-key"
GROQ_API_KEY="gsk_your_groq_api_key"
GOOGLE_API_KEY="AIzaSy_your_gemini_api_key"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key"
DEFAULT_MODEL="gpt-4o"
MODEL_TEMPERATURE=0.7
MAX_TOKENS=4096

# ==================== FILE STORAGE CONFIGURATION ====================
UPLOAD_DIRECTORY="uploads"
MAX_UPLOAD_SIZE_MB=25
TEMP_DIRECTORY="tmp"

# ==================== EMAIL SMTP CONFIGURATION ====================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="smtpuser@neurodesk.ai"
SMTP_PASSWORD="your_smtp_password"
SMTP_TLS=True
EMAIL_FROM="noreply@neurodesk.ai"

# ==================== RATE LIMITING CONFIGURATION ====================
REQUESTS_PER_MINUTE=60
REQUESTS_PER_HOUR=1000

# ==================== ANALYTICS & FEATURE FLAGS ====================
ENABLE_ANALYTICS=True
TRACK_USAGE=True
ENABLE_CHAT=True
ENABLE_RAG=True
ENABLE_DOCUMENTS=True
ENABLE_TEAMS=True
ENABLE_BILLING=False
LOG_LEVEL="INFO"
